{
  "id": "domain/operations/decision-cancel-remaining-never-reaches-the-backend",
  "kind": "domain",
  "summary": "Submitting with the cancel_remaining decision completes without dispatching: nothing started, nothing changed, the source stays remaining",
  "given": {"capabilities": {"version": 1, "supported": ["list", "copy", "create", "search_filename", "trash"], "containment": {"ancestors": ["mock://host/root"]}}},
  "steps": [
    {"do": "submit", "subject": "operations", "id": 1, "kind": "copy", "sources": ["mock://host/source-0"], "destination": "mock://host/destination", "decision": "cancel_remaining", "as": "op1"},
    {"expect": "port_requests", "port": "operations", "count": 0},
    {"expect": "record", "ref": "$op1", "change": "unchanged", "remaining": ["mock://host/source-0"], "lacks_events": ["started"], "events_count": 1}
  ]
}
