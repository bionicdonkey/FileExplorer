{
  "id": "domain/operations/opaque-request-blocks-a-trusted-request-and-local-lock-keys-are-sorted",
  "kind": "domain",
  "summary": "An opaque provider serializes against everything, even a request with proven ancestors; local lock keys list each ancestor once, sorted",
  "given": {"capabilities": {"version": 1, "supported": ["list", "copy", "create", "search_filename", "trash"], "containment": {"ancestors": ["mock://host/root"]}}},
  "steps": [
    {"do": "submit", "subject": "operations", "id": 1, "kind": "trash", "sources": ["mock://host/source-0", "mock://host/source-1", "mock://host/source-2"], "capabilities": {"containment": "opaque", "with": ["trash"]}, "as": "op1"},
    {"do": "submit", "subject": "operations", "id": 2, "kind": "trash", "sources": ["mock://host/different"], "capabilities": {"containment": {"ancestors": ["mock://host/ancestor"]}, "with": ["trash"]}, "as": "op2"},
    {"port": "capabilities", "request": 1, "respond": {"succeeded": {"containment": "opaque", "with": ["trash"]}}},
    {"expect": "record", "ref": "$op2", "state": "queued"},
    {"expect": "lock_keys", "for": {"id": 3, "kind": "copy", "sources": ["file:///tmp/a"], "destination": "file:///var/out"}, "capabilities": {"containment": "opaque"}, "is": ["file:///", "file:///tmp", "file:///tmp/a", "file:///var", "file:///var/out", "file:///var/out/a"]}
  ]
}
