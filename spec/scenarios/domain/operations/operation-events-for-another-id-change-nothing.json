{
  "id": "domain/operations/operation-events-for-another-id-change-nothing",
  "kind": "domain",
  "summary": "A backend event carrying a different operation id is rejected: the other record stays queued and no lock is released",
  "note": "Both operations are inspected up front; the second stays queued behind the first's destination lock.",
  "given": {"capabilities": {"version": 1, "supported": ["list", "copy", "create", "search_filename", "trash"], "containment": {"ancestors": ["mock://host/root"]}}},
  "steps": [
    {"do": "submit", "subject": "operations", "id": 1, "kind": "copy", "sources": ["file:///source-1"], "destination": "file:///destination", "as": "op1"},
    {"do": "submit", "subject": "operations", "id": 2, "kind": "copy", "sources": ["file:///source-2"], "destination": "file:///destination", "as": "op2"},
    {"port": "capabilities", "request": 1, "respond": {"succeeded": {}}},
    {"port": "capabilities", "request": 2, "respond": {"succeeded": {}}},
    {"expect": "lock_keys", "active_count_is": "non_zero"},
    {"port": "operations", "request": 1, "as_id": 2, "emit": [{"succeeded": {}}]},
    {"expect": "record", "ref": "$op2", "state": "queued", "events": []},
    {"expect": "lock_keys", "active_count_is": "non_zero"},
    {"port": "operations", "request": 1, "as_id": 1, "emit": [{"succeeded": {}}]},
    {"expect": "record", "ref": "$op1", "state": "succeeded"}
  ]
}
