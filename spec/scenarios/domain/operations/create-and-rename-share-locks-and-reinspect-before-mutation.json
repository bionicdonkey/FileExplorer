{
  "id": "domain/operations/create-and-rename-share-locks-and-reinspect-before-mutation",
  "kind": "domain",
  "summary": "A queued rename waits for a running create on the same destination, and is inspected again when it becomes ready",
  "given": {"capabilities": {"version": 1, "supported": ["list", "copy", "create", "search_filename", "trash"], "containment": {"ancestors": ["mock://host/root"]}}},
  "steps": [
    {"do": "submit", "subject": "operations", "id": 1, "kind": "create", "sources": ["file:///source-1"], "capabilities": {"with": ["rename"]}, "as": "op1"},
    {"do": "submit", "subject": "operations", "id": 2, "kind": "rename", "sources": ["file:///source-2"], "destination": "file:///destination", "capabilities": {"with": ["rename"]}, "as": "op2"},
    {"expect": "port_requests", "port": "capabilities", "count": 1},
    {"port": "capabilities", "request": 1, "respond": {"succeeded": {"with": ["rename"]}}},
    {"expect": "port_requests", "port": "capabilities", "count": 1},
    {"expect": "record", "ref": "$op2", "state": "queued"},
    {"port": "operations", "request": 1, "emit": [{"succeeded": {}}]},
    {"expect": "port_requests", "port": "capabilities", "count": 2},
    {"port": "capabilities", "request": 2, "respond": {"succeeded": {}}},
    {"expect": "port_requests", "port": "operations", "count": 1},
    {"expect": "record", "ref": "$op2", "state": "failed", "error": "capability_changed"},
    {"expect": "lock_keys", "active_count_is": "zero"}
  ]
}
