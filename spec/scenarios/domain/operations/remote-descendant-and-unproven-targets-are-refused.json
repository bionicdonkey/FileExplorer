{
  "id": "domain/operations/remote-descendant-and-unproven-targets-are-refused",
  "kind": "domain",
  "summary": "A transfer into a remote descendant of its own source is refused at submit, whether containment is unknown or proven, without inspecting anything",
  "given": {"capabilities": {"version": 1, "supported": ["list", "copy", "create", "search_filename", "trash"], "containment": {"ancestors": ["mock://host/root"]}}},
  "steps": [
    {"do": "submit", "subject": "operations", "id": 1, "kind": "copy", "sources": ["smb://host/share/a"], "destination": "smb://host/share/a/child", "capabilities": {"containment": "opaque"}, "as_result": "opaque"},
    {"expect": "submit_result", "ref": "$opaque", "is": "refused"},
    {"do": "submit", "subject": "operations", "id": 2, "kind": "copy", "sources": ["smb://host/share/a"], "destination": "smb://host/share/a/child", "capabilities": {"containment": {"ancestors": ["smb://host/share/a"]}}, "as_result": "known"},
    {"expect": "submit_result", "ref": "$known", "is": "refused"},
    {"expect": "port_requests", "port": "capabilities", "count": 0}
  ]
}
