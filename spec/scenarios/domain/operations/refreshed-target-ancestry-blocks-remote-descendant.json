{
  "id": "domain/operations/refreshed-target-ancestry-blocks-remote-descendant",
  "kind": "domain",
  "summary": "When the destination's fresh inspection proves it lies inside a source, the operation fails as invalid_request before dispatch and releases its locks",
  "given": {"capabilities": {"version": 1, "supported": ["list", "copy", "create", "search_filename", "trash"], "containment": {"ancestors": ["mock://host/root"]}}},
  "steps": [
    {"do": "submit", "subject": "operations", "id": 1, "kind": "copy", "sources": ["mock://host/source-0"], "destination": "mock://host/destination", "as": "op1"},
    {"port": "capabilities", "request": 1, "respond": {"succeeded": {}}},
    {"port": "capabilities", "request": 2, "respond": {"succeeded": {"containment": {"ancestors": ["mock://host/source-0"]}}}},
    {"expect": "port_requests", "port": "operations", "count": 0},
    {"expect": "record", "ref": "$op1", "state": "failed", "error": "invalid_request"},
    {"expect": "lock_keys", "active_count_is": "zero"}
  ]
}
