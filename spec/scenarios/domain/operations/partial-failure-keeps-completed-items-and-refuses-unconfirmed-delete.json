{
  "id": "domain/operations/partial-failure-keeps-completed-items-and-refuses-unconfirmed-delete",
  "kind": "domain",
  "summary": "A failure after one of three items keeps the completed and remaining sources and reports a partial change; a delete without confirmation is refused at submit",
  "given": {"capabilities": {"version": 1, "supported": ["list", "copy", "create", "search_filename", "trash"], "containment": {"ancestors": ["mock://host/root"]}}},
  "steps": [
    {"do": "submit", "subject": "operations", "id": 1, "kind": "copy", "sources": ["mock://host/source-0", "mock://host/source-1", "mock://host/source-2"], "destination": "mock://host/destination", "as": "op1"},
    {"do": "submit", "subject": "operations", "id": 2, "kind": "delete", "sources": ["mock://host/source-0"], "as_result": "delete"},
    {"expect": "submit_result", "ref": "$delete", "is": "refused"},
    {"port": "capabilities", "request": 1, "respond": {"succeeded": {}}},
    {"port": "capabilities", "request": 2, "respond": {"succeeded": {}}},
    {"port": "capabilities", "request": 3, "respond": {"succeeded": {}}},
    {"port": "capabilities", "request": 4, "respond": {"succeeded": {}}},
    {"port": "operations", "request": 1, "emit": ["started", {"progress": [1, 3]}, {"failed": {"kind": "permission_denied", "effect": "partially_changed", "completed": ["mock://host/source-0"], "remaining": ["mock://host/source-1", "mock://host/source-2"]}}]},
    {"expect": "record", "ref": "$op1", "state": "failed", "error": "permission_denied", "change": "partial", "completed": ["mock://host/source-0"], "remaining": ["mock://host/source-1", "mock://host/source-2"], "terminal_events": 1}
  ]
}
