{
  "id": "adapter/operations/permission-denied-leaves-everything-unchanged",
  "kind": "adapter",
  "summary": "An unreadable source and a read-only destination both fail as permission_denied with no effect, so they remain eligible for an elevated retry",
  "note": "Skipped, not failed, when the process can read mode-000 files (root), since permission failures cannot be produced there.",
  "given": {"requires": ["unprivileged"], "tree": [{"file": "private", "content": "x", "mode": "unreadable"}, {"dir": "open"}, {"file": "plain", "content": "y"}, {"dir": "locked", "mode": "readonly"}]},
  "steps": [
    {"do": "operate", "kind": "copy", "sources": ["private"], "destination": "open", "as": "unreadable"},
    {"expect": "outcome", "ref": "$unreadable", "is": "failed", "error": {"kind": "permission_denied"}},
    {"expect": "effect", "ref": "$unreadable", "is": "unchanged"},
    {"do": "operate", "kind": "copy", "sources": ["plain"], "destination": "locked", "as": "readonly"},
    {"expect": "outcome", "ref": "$readonly", "is": "failed", "error": {"kind": "permission_denied"}},
    {"expect": "effect", "ref": "$readonly", "is": "unchanged"}
  ]
}
