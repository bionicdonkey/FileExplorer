{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Behaviour scenario",
  "description": "The common shape of spec section 3. Step fields beyond the action or matcher name are checked by each platform's runner; this schema fixes the vocabulary of names.",
  "type": "object",
  "required": ["id", "kind", "summary", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^(adapter|domain)/[a-z0-9-]+/[a-z0-9-]+$" },
    "kind": { "enum": ["adapter", "domain"] },
    "summary": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "given": { "type": "object" },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linux": { "$ref": "#/$defs/override" },
        "macos": { "$ref": "#/$defs/override" }
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "properties": {
        "do": {
          "enum": [
            "list", "list_pages", "inspect", "manage", "extract", "compress", "operate", "search", "watch", "mutate", "cancel", "wait",
            "navigate", "back", "forward", "refresh", "retry", "close",
            "type", "submit", "clear",
            "retry_elevated",
            "cut", "copy", "paste", "external_payload",
            "advance",
            "start", "apply", "select", "expand_scope", "record_submitted", "unmount", "show_section", "replace", "begin_paste", "finish_paste", "pin", "save", "reload"
          ]
        },
        "expect": {
          "enum": [
            "outcome", "events", "effect", "entries", "entry", "pages", "history", "tree", "search", "changed", "capability",
            "port_requests", "request_cancelled", "view", "record", "clipboard",
            "lock_keys", "submit_result", "cancel_result", "reducer", "search_history", "location", "session", "named_child", "clipboard_payload", "pins", "activation", "file_types_table", "error_table"
          ]
        },
        "port": { "enum": ["directory", "capabilities", "operations", "search"] },
        "subject": { "enum": ["navigation", "search", "operations", "reducer", "clipboard", "clock", "location", "file_types", "search_history", "pins"] },
        "as": { "type": "string" },
        "note": { "type": "string" }
      },
      "oneOf": [
        { "required": ["do"], "not": { "anyOf": [{ "required": ["expect"] }, { "required": ["respond"] }, { "required": ["emit"] }] } },
        { "required": ["expect"], "not": { "anyOf": [{ "required": ["do"] }, { "required": ["respond"] }, { "required": ["emit"] }] } },
        {
          "required": ["port", "request"],
          "oneOf": [{ "required": ["respond"] }, { "required": ["emit"] }],
          "not": { "anyOf": [{ "required": ["do"] }, { "required": ["expect"] }] }
        }
      ]
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "note": { "type": "string" },
        "replace_step": {
          "type": "object",
          "patternProperties": { "^[0-9]+$": { "$ref": "#/$defs/step" } },
          "additionalProperties": false
        },
        "skip_step": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      },
      "dependentRequired": { "skip_step": ["note"] }
    }
  }
}
